{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["/etc/ai-harness/AGENTS.md"],
  "provider": {
    "cluster": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cluster (internal)",
      "options": {
        "baseURL": "{env:AI_INTERNAL_BASE_URL}"
      },
      "models": {
        "cluster-qwen": {
          "name": "Qwen (internal)",
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "pwd": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "grep*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "shellcheck*": "allow",
      "slurm-check*": "allow",
      "sinfo*": "allow",
      "squeue*": "allow",
      "sacct*": "allow",
      "scontrol show*": "allow",
      "sbatch*": "ask",
      "sbatch --test-only*": "allow",
      "scancel*": "ask"
    }
  }
}
