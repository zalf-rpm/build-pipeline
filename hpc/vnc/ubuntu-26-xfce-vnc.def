# Ubuntu 26.04 based VNC image for HPC usage
Bootstrap: docker
From: ubuntu:26.04

%environment
    export LANG=en_US.UTF-8
    export LANGUAGE=en_US:en
    export LC_ALL=en_US.UTF-8
    export TERM=xterm
    export VNC_COL_DEPTH=24
    export VNC_RESOLUTION=1920x1080
    #export VNC_PW=vncpassword
    export VNC_VIEW_ONLY=true
    export DISPLAY=:1
    # glycin uses bubblewrap for SVG sandboxing which fails inside Singularity
    export GLYCIN_SANDBOX_MECHANISM=none

%files
    ./scripts/. /opt/
%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        locales \
        ca-certificates \
        xfce4 \
        xfce4-goodies \
        tigervnc-standalone-server \
        tigervnc-tools \
        novnc \
        websockify \
        supervisor \
        dbus-x11 \
        sudo \
        curl \
        wget \
        bash \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    locale-gen en_US.UTF-8
    update-locale LANG=en_US.UTF-8

    mkdir -p /opt

    chmod 755 /opt/wm_startup.sh /opt/vnc_startup-ubuntu-26.sh
    apt-get clean
    rm -rf /var/lib/apt/lists/*
